# Every integration falls back to a deterministic local mock when its key is unset,
# so the full demo runs with none of these.

# Claude: Extract, Optimize, Reviewer
ANTHROPIC_API_KEY=

# Capital One Nessie (http://api.nessieisreal.com)
NESSIE_API_KEY=
NESSIE_ACCOUNT_ID=
NESSIE_PAYEE_ACCOUNT_ID=

# Cartesia TTS for the booking call
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# Multi-store price feeds for the Bazaar's seller agents (optional; without them agents search the web)
# SerpApi Google Shopping: free 250 searches/month at https://serpapi.com
SERPAPI_API_KEY=
# eBay Browse API: free keys at https://developer.ebay.com (Production keyset)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
