# Copy to .env.local and fill in what you have. Every integration falls back to a local mock or
# a simpler path when its key is unset, so the game runs with none of these.

# Claude: document reading, Ruth's reviews, shopping agents, villagers, benefit lookups
ANTHROPIC_API_KEY=

# Multiplayer world (SpacetimeDB) and saved games (Convex)
NEXT_PUBLIC_SPACETIMEDB_HOST=ws://127.0.0.1:3100
NEXT_PUBLIC_CONVEX_URL=

# Apify: live store prices and the Bazaar's Google Shopping feed
APIFY_TOKEN=
# Optional: the benefit-terms watcher actor (actors/benefit-terms-watcher) once you've pushed it
APIFY_TERMS_ACTOR=

# Optional extra price feeds for the Bazaar
SERPAPI_API_KEY=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Capital One Nessie sandbox (http://api.nessieisreal.com); run `npm run seed:nessie` once
NESSIE_API_KEY=
NESSIE_CUSTOMER_ID=
NESSIE_ACCOUNT_ID=
NESSIE_PAYEE_ACCOUNT_ID=

# Cartesia: villager voices and speech-to-text check-ins
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# x402 agent payments on Base Sepolia (testnet only). `npm run x402:wallets` makes test wallets.
# Never put a mainnet key here.
X402_PAYER_KEY=
X402_PAY_TO=
X402_FACILITATOR_URL=https://x402.org/facilitator

# Optional local model for light tasks (falls back to Claude)
OLLAMA_URL=http://127.0.0.1:11434
LLM_LOCAL_MODEL=qwen3.5:4b
