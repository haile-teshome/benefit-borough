{
  "name": "expire",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "test": "tsx --test 'lib/**/*.test.ts'",
    "valley:server": "spacetime start --listen-addr 0.0.0.0:3100",
    "valley:publish": "cd valley-server && spacetime publish expire-valley --server valley --yes",
    "valley:reset": "cd valley-server && spacetime publish expire-valley --server valley --delete-data=always --yes && rm -f ../.data/state-*.json",
    "valley:generate": "cd valley-server && spacetime generate --lang typescript --out-dir ../lib/valley_bindings --module-path .",
    "convex:push": "convex dev --once",
    "check:keys": "tsx --env-file=.env.local scripts/check-keys.ts",
    "seed:nessie": "tsx --env-file=.env.local scripts/seed-nessie.ts",
    "x402:wallets": "tsx scripts/x402-wallets.ts",
    "x402:try": "tsx --env-file=.env.local scripts/x402-try.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@x402/core": "^2.28.0",
    "@x402/evm": "^2.28.0",
    "@x402/fetch": "^2.28.0",
    "@x402/next": "^2.28.0",
    "convex": "^1.27.3",
    "next": "^15.5.28",
    "pdf-lib": "^1.17.1",
    "postprocessing": "^6.39.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "spacetimedb": "2.13.*",
    "three": "^0.186.1",
    "unpdf": "^1.3.2",
    "viem": "^2.57.11",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
